<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/activity_background">
    <include layout="@layout/layout_select"
        android:id="@+id/layout_category"/>
    <include layout="@layout/layout_dish_confirm"
        android:id="@+id/layout_dish_confirm"
        android:layout_width="0dp"
        android:layout_height="105dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/layout_category"
        app:layout_constraintEnd_toEndOf="parent"/>
    <include layout="@layout/layout_nourishing_food"
        android:id="@+id/layout_nourishing_food"
        android:layout_width="0dp"
        android:layout_height="78dp"
        app:layout_constraintStart_toEndOf="@id/layout_category"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="15dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcy_dish"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layout_nourishing_food"
        app:layout_constraintStart_toEndOf="@id/layout_category"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_dish_confirm"/>
</androidx.constraintlayout.widget.ConstraintLayout>